{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalSpotify",
  "version": "1.0.0",
  "identifier": "com.localspotify.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LocalSpotify",
        "width": 1150,
        "height": 760,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
