{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subsonic Player",
  "version": "1.0.0",
  "identifier": "com.subsonicplayer.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../subsonic-player run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../subsonic-player run generate",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Subsonic Player",
        "width": 1150,
        "height": 760,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
